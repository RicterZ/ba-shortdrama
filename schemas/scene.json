{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "renderer",
    "palette",
    "default_variant"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "renderer": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "default_variant": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "palette": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "credit": {
      "type": "string"
    }
  }
}
