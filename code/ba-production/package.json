{
  "name": "ba-production",
  "private": true,
  "scripts": {
    "ep:new": "uv run python scripts/new_episode.py",
    "ep:prepare": "uv run python scripts/prepare.py --episode $EPISODE",
    "ep:validate": "uv run python scripts/validate.py --all",
    "ep:preview": "uv run python scripts/render.py --episode $EPISODE --profile preview --mode video",
    "ep:final": "uv run python scripts/render.py --episode $EPISODE --profile final --mode video",
    "ep:still": "uv run python scripts/render.py --episode $EPISODE --mode still",
    "res:kivo": "uv run python scripts/fetch_kivo.py",
    "res:sprites": "uv run python scripts/fetch_sprites.py",
    "test:sprites": "uv run python scripts/test_fetch_sprites.py",
    "res:check": "uv run python scripts/fetch_kivo.py check",
    "bg:build": "uv run python scripts/build_backgrounds.py",
    "bg:check": "uv run python scripts/check_backgrounds.py",
    "bg:test": "uv run python scripts/test_backgrounds.py",
    "voice": "uv run python scripts/voice.py",
    "voice:check": "uv run python scripts/voice.py check"
  },
  "dependencies": {
    "@remotion/cli": "4.0.417",
    "remotion": "4.0.417",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
