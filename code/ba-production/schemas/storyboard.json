{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "shots"
  ],
  "properties": {
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "characters",
          "lines"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "background": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "type"
                ]
              }
            ]
          },
          "scene": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "variant": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "camera": {
            "enum": [
              "static",
              "punch-in",
              "push-in",
              "pull-back"
            ]
          },
          "durationInFrames": {
            "type": "integer",
            "minimum": 1,
            "description": "仅无台词镜头使用：这一段反应镜头的固定长度。"
          },
          "focus": {
            "type": "string",
            "description": "聚光灯角色 id；只在没有台词的心理/反应镜头里生效。"
          },
          "monologue": {
            "type": "object",
            "required": [
              "speaker",
              "text"
            ],
            "properties": {
              "speaker": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          },
          "voteTags": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "speaker",
                "text"
              ],
              "properties": {
                "speaker": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "transition": {
            "oneOf": [
              {
                "enum": [
                  "fade",
                  "slide",
                  "wipe",
                  "flip",
                  "clock-wipe",
                  "iris",
                  "none"
                ]
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "fade",
                      "slide",
                      "wipe",
                      "flip",
                      "clock-wipe",
                      "iris",
                      "none"
                    ]
                  },
                  "durationInFrames": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "direction": {
                    "type": "string"
                  },
                  "easing": {
                    "enum": [
                      "linear",
                      "ease-in-out"
                    ]
                  },
                  "perspective": {
                    "type": "number",
                    "minimum": 1
                  },
                  "shouldFadeOutExitingScene": {
                    "type": "boolean"
                  }
                }
              }
            ]
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "outfit": {
                  "type": "string"
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "bottom": {
                  "type": "number",
                  "minimum": -2,
                  "maximum": 1
                },
                "height": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 3
                },
                "scale": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 3
                },
                "entrance": {
                  "enum": [
                    "none",
                    "fade-in",
                    "slide-in-left",
                    "slide-in-right"
                  ]
                },
                "exit": {
                  "enum": [
                    "none",
                    "fade-out"
                  ]
                },
                "emotion": {
                  "type": "string"
                },
                "label": {
                  "type": "object",
                  "required": [
                    "text"
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "tone": {
                      "enum": [
                        "normal",
                        "secret"
                      ]
                    },
                    "rotate": {
                      "type": "number"
                    }
                  }
                },
                "holdEmotion": {
                  "type": "boolean"
                },
                "emotionCues": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "emotion",
                      "startFrame"
                    ],
                    "properties": {
                      "emotion": {
                        "type": "string",
                        "minLength": 1
                      },
                      "startFrame": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                },
                "facing": {
                  "enum": [
                    "left",
                    "right"
                  ]
                },
                "turns": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "to"
                    ],
                    "properties": {
                      "to": {
                        "enum": [
                          "left",
                          "right"
                        ]
                      },
                      "atLine": {
                        "type": "string",
                        "minLength": 1
                      },
                      "startFrame": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "durationInFrames": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                },
                "motion": {
                  "type": "object",
                  "properties": {
                    "fromX": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "toX": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "fromBottom": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "toBottom": {
                      "type": "number",
                      "minimum": -1,
                      "maximum": 1
                    },
                    "fromScale": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 3
                    },
                    "toScale": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 3
                    },
                    "startFrame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "endFrame": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "ease": {
                      "enum": [
                        "linear",
                        "ease-in-out"
                      ]
                    },
                    "hops": {
                      "type": "integer",
                      "minimum": 2
                    },
                    "hopLift": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 0.5
                    }
                  }
                },
                "actions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "startFrame"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "enum": [
                          "jump",
                          "hophop",
                          "greeting",
                          "shake",
                          "stiff",
                          "closeup",
                          "falldownL",
                          "falldownR",
                          "hide"
                        ]
                      },
                      "startFrame": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                },
                "bubbles": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "anyOf": [
                      {
                        "required": [
                          "startFrame"
                        ]
                      },
                      {
                        "required": [
                          "atLine"
                        ]
                      },
                      {
                        "required": [
                          "afterLine"
                        ]
                      }
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "enum": [
                          "Angry",
                          "Upset",
                          "Chat",
                          "Exclaim",
                          "Heart",
                          "Dot",
                          "Music",
                          "Surprise",
                          "Question",
                          "Respond",
                          "Shy",
                          "Sweat",
                          "Twinkle",
                          "Bulb",
                          "Sigh",
                          "Sad",
                          "Steam",
                          "Zzz",
                          "Tear",
                          "Think"
                        ]
                      },
                      "startFrame": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "atLine": {
                        "type": "string",
                        "minLength": 1
                      },
                      "afterLine": {
                        "type": "string",
                        "minLength": 1
                      },
                      "offsetFrames": {
                        "type": "integer"
                      },
                      "sound": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "choices": {
            "type": "object",
            "required": [
              "options"
            ],
            "properties": {
              "prompt": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "selected": {
                "type": "integer",
                "minimum": 0
              },
              "fromFrame": {
                "type": "integer",
                "minimum": 0
              },
              "selectFrame": {
                "type": "integer",
                "minimum": 0
              },
              "hideFrame": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "buttons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "width": {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 1
                },
                "pressFrame": {
                  "type": "integer",
                  "minimum": 0
                },
                "variant": {
                  "enum": [
                    "primary",
                    "secondary"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
